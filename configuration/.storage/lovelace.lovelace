                            "action": "toggle",
                            "confirmation": {
                              "text": "{% if is_state('input_boolean.deye_6kw_night_standby','on') %}Вимкнути At night? 6kW працюватиме всю ніч від своєї батареї (без Standby).{% else %}Увімкнути At night? Уночі 6kW піде в Standby на порозі SOC (дім ~30 с без світла).{% endif %}"
                            }
                          }
                        },
                        {
                          "entity": "input_boolean.deye_6kw_snow",
                          "name": "Snow",
                          "toggle": true,
                          "tap_action": {
                            "action": "toggle",
                            "confirmation": {
                              "text": "{% if is_state('input_boolean.deye_6kw_snow','on') %}Вимкнути Snow? 6kW знову прокидатиметься від сонця.{% else %}Увімкнути Snow? 6kW одразу піде в Standby (дім ~30 с без світла) і не прокидатиметься від сонця.{% endif %}"
                            }
                          }
                        }
                      ],
                      "card_mod": {
                        "style": {
                          ".": ":host {\n  display: block;\n}\n",
                          "hui-generic-entity-row $": ".row {\n  height: 40px;\n  min-height: 40px;\n}\nstate-badge {\n  height: 40px;\n}\n"
                        }
                      }
                    }
                  ],
                  "card_mod": {
                    "style": "ha-card {\n  --entities-card-row-gap: 4px;\n}\n"
                  }
                }
              ]
            },
            {
              "color": "none",
              "type": "entities",
