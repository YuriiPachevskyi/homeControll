                              "name": "Поточна потужність",
                              "yaxis_id": "power",
                              "type": "area",
                              "color": "#9b59b6",
                              "extend_to": false,
                              "opacity": 0.15,
                              "float_precision": 0,
                              "group_by": {
                                "func": "avg",
                                "duration": "10m"
                              },
                              "show": {
                                "legend_value": false
                              }
                            }
                          ]
                        },
                        "heading": "Напруга: мережа та стабілізована",
                        "icon": "mdi:sine-wave",
                        "badge_entity": "sensor.breaker_phase_a_voltage"
                      }
                    ]
                  }
                ]
              },
