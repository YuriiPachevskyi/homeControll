                            "borderColor": "#33333333"
                          },
                          "legend": {
                            "show": true,
                            "position": "bottom",
                            "horizontalAlign": "center"
                          },
                          "dataLabels": {
                            "enabled": false
                          }
                        },
                        "yaxis": [
                          {
                            "id": "power",
                            "min": 0,
                            "max": "~12",
                            "decimals": 0,
                            "apex_config": {
                              "tickAmount": 6,
                              "title": {
                                "text": "кВт"
                              }
                            }
