{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.lovelace",
  "data": {
    "config": {
      "views": [
        {
          "path": "default_view",
          "title": "Home",
          "cards": [
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "heading",
                  "heading_style": "title",
                  "heading": "Deye 5KW:",
                  "badges": [
                    {
                      "type": "entity",
                      "entity": "input_boolean.home_combined_flow_expanded",
                      "icon": "mdi:chevron-down-circle",
                      "show_state": true,
                      "show_icon": true,
                      "tap_action": {
                        "action": "toggle"
                      },
                      "visibility": [
                        {
                          "condition": "screen",
                          "media_query": "(max-width: 767px)"
                        },
                        {
                          "condition": "state",
                          "entity": "input_boolean.home_combined_flow_expanded",
                          "state": "off"
                        }
                      ],
                      "color": "primary",
                      "name": "Total",
                      "state_content": "name"
                    },
                    {
                      "type": "entity",
                      "entity": "input_boolean.home_combined_flow_expanded",
                      "icon": "mdi:chevron-up-circle",
                      "show_state": true,
                      "show_icon": true,
                      "tap_action": {
                        "action": "toggle"
                      },
                      "visibility": [
                        {
                          "condition": "screen",
                          "media_query": "(max-width: 767px)"
                        },
                        {
                          "condition": "state",
                          "entity": "input_boolean.home_combined_flow_expanded",
                          "state": "on"
                        }
                      ],
                      "color": "primary",
                      "name": "Total",
                      "state_content": "name"
                    }
                  ],
                  "card_mod": {
                    "style": ".title .heading::after {\n  content: \" {{ states('sensor.deye_5kw_device_state') }}\";\n  color: {% set s = states('sensor.deye_5kw_device_state') %}{% if s == 'Normal' and is_state('select.deye_5kw_battery_operation_mode', 'No Battery') %}var(--green-color, #4caf50){% elif s == 'Normal' %}var(--amber-color, #ffc107){% elif s == 'Standby' %}var(--blue-color, #2196f3){% elif s in ['Fault', 'Alarm'] %}var(--red-color, #f44336){% elif s == 'Self-test' %}var(--purple-color, #9c27b0){% else %}var(--disabled-text-color, #9e9e9e){% endif %};\n}"
                  }
                },
                {
                  "type": "custom:sunsynk-power-flow-card",
                  "cardstyle": "lite",
                  "wide": false,
                  "large_font": false,
                  "show_solar": true,
                  "show_battery": true,
                  "show_grid": true,
                  "center_no_grid": false,
                  "card_height": "100%",
                  "card_width": "100%",
                  "decimal_places": 2,
                  "decimal_places_energy": 1,
                  "dynamic_line_width": true,
                  "max_line_width": 4,
                  "min_line_width": 1,
                  "inverter": {
                    "modern": true,
                    "autarky": "no"
                  },
                  "battery": {
                    "energy": 0,
                    "shutdown_soc": "input_number.deye_5kw_min_soc",
                    "show_daily": true
                  },
                  "battery2": {
                    "energy": 0,
                    "shutdown_soc": 20,
                    "soc_end_of_charge": 100,
                    "invert_power": false,
                    "hide_soc": false,
                    "colour": "#ffc0cb",
                    "show_remaining_energy": true,
                    "remaining_energy_to_shutdown": false,
                    "show_absolute": false,
                    "auto_scale": true,
                    "dynamic_colour": true,
                    "linear_gradient": true,
                    "animate": true,
                    "path_threshold": 100,
                    "navigate": "",
                    "invert_flow": false
                  },
                  "solar": {
                    "show_daily": true,
                    "mppts": 2
                  },
                  "load": {
                    "show_daily": true,
                    "auto_scale": true
                  },
                  "grid": {
                    "show_daily_buy": true,
                    "show_daily_sell": true,
                    "show_nonessential": true,
                    "auto_scale": false,
                    "show_absolute": false
                  },
                  "entities": {
                    "inverter_voltage_154": "sensor.deye_5kw_grid_l1_voltage",
                    "load_frequency_192": "sensor.deye_5kw_grid_frequency",
                    "inverter_current_164": "sensor.deye_5kw_grid_l1_current",
                    "inverter_power_175": "sensor.deye_5kw_power",
                    "grid_connected_status_194": "binary_sensor.deye_5kw_grid",
                    "day_battery_charge_70": "sensor.deye_5kw_today_battery_charge",
                    "day_battery_discharge_71": "sensor.deye_5kw_today_battery_discharge",
                    "battery_voltage_183": "sensor.deye_5kw_battery_voltage",
                    "battery_soc_184": "sensor.deye_5kw_battery",
                    "battery_power_190": "sensor.deye_5kw_battery_power",
                    "battery_current_191": "sensor.deye_5kw_battery_current",
                    "grid_power_169": "sensor.deye_5kw_grid_power",
                    "day_grid_import_76": "sensor.deye_5kw_today_energy_import",
                    "day_grid_export_77": "sensor.deye_5kw_today_energy_export",
                    "grid_ct_power_172": "sensor.deye_5kw_grid_power",
                    "day_load_energy_84": "sensor.deye_5kw_today_load_consumption",
                    "essential_power": "sensor.deye_5kw_load_power",
                    "nonessential_power": "none",
                    "day_pv_energy_108": "sensor.deye_5kw_today_production",
                    "pv1_power_186": "sensor.deye_5kw_pv1_power",
                    "pv2_power_187": "sensor.deye_5kw_pv2_power",
                    "pv1_voltage_109": "sensor.deye_5kw_pv1_voltage",
                    "pv1_current_110": "sensor.deye_5kw_pv1_current",
                    "pv2_voltage_111": "sensor.deye_5kw_pv2_voltage",
                    "pv2_current_112": "sensor.deye_5kw_pv2_current",
                    "battery_temp_182": "sensor.deye_5kw_battery_temperature",
                    "grid_ct_power_total": "sensor.total_grid_power_realtime",
                    "essential_load1": "sensor.total_load_power_realtime"
                  },
                  "card_mod": {
                    "style": "ha-card {\n  border-bottom-left-radius: 0 !important;\n  border-bottom-right-radius: 0 !important;\n  border-bottom: none !important;\n}\n/* Per-string daily PV energy next to the PV1/PV2 boxes (packages/energy/pv_strings.yaml).\n   Positions are in SVG viewBox units (490 wide) converted to cqw. */\nha-card {\n  container-type: inline-size;\n}\nha-card::before,\nha-card::after {\n  position: absolute;\n  top: 13.2cqw;\n  font: 2.65cqw/1 Roboto, Noto, sans-serif;\n  color: {{ '#FFA500' if (states('sensor.deye_5kw_pv1_power') | float(0) + states('sensor.deye_5kw_pv2_power') | float(0)) > 10 else 'grey' }};\n  pointer-events: none;\n}\nha-card::before {\n  content: \"{{ '%.1f' | format(states('sensor.deye_5kw_pv1_energy_daily') | float(0)) }} kWh\";\n  right: 69.6cqw;\n}\nha-card::after {\n  content: \"{{ '%.1f' | format(states('sensor.deye_5kw_pv2_energy_daily') | float(0)) }} kWh\";\n  left: 67.8cqw;\n}\n/* Installed panel power inside the PV1/PV2 boxes, above the live power */\n.container::before,\n.container::after {\n  position: absolute;\n  top: 11.9cqw;\n  font: 1.63cqw/1 Roboto, Noto, sans-serif;\n  color: {{ '#FFA500' if (states('sensor.deye_5kw_pv1_power') | float(0) + states('sensor.deye_5kw_pv2_power') | float(0)) > 10 else 'grey' }};\n  transform: translateX(-50%);\n  pointer-events: none;\n}\n.container::before {\n  content: \"4.1 kW\";\n  left: 38.8cqw;\n}\n.container::after {\n  content: \"2.46 kW\";\n  left: 59.5cqw;\n}\n#pv1_power_186,\n#pv2_power_187 {\n  transform: translateY(4px);\n}\n"
                  }
                },
                {
                  "type": "entities",
                  "card_mod": {
                    "style": "ha-card {\n  margin-top: -8px;\n  border-top-left-radius: 0 !important;\n  border-top-right-radius: 0 !important;\n  border-top: 1px solid var(--divider-color) !important;\n}\n"
                  },
                  "entities": [
                    {
                      "entity": "input_number.export_deye_5kw_power",
                      "name": "Export",
                      "icon": "mdi:transmission-tower-export",
                      "card_mod": {
                        "style": {
                          ".": ":host {\n  display: block;\n  margin: -2px 0;\n}\n.flex {\n  height: 28px;\n  align-items: center;\n}\n.state {\n  font-size: 0;\n}\n.state::after {\n  content: \"{{ (states('input_number.export_deye_5kw_power') | float(0) / 1000) | round(1) }} kW\";\n  font-size: var(--ha-font-size-m, 14px);\n}\n{% if is_state('input_select.deye_system_state', 'Idle') and not (states('input_datetime.deye_morning_export_start_time') <= now().strftime('%H:%M:%S') < states('input_datetime.deye_night_idle_start_time')) %}\n:host {\n  pointer-events: none;\n  opacity: 0.45;\n}\n{% endif %}\n",
                          "hui-generic-entity-row $": ".row {\n  height: 28px;\n  min-height: 28px;\n}\nstate-badge {\n  height: 28px;\n  --mdc-icon-size: 22px;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "custom:multiple-entity-row",
                      "entity": "input_number.deye_5kw_min_soc",
                      "name": "Battery",
                      "icon": "mdi:battery-charging",
                      "show_state": false,
                      "state_color": false,
                      "entities": [
                        {
                          "entity": "input_number.deye_5kw_min_soc",
                          "name": "Min SOC",
                          "unit": "%",
                          "format": "precision0"
                        },
                        {
                          "entity": "input_number.deye_5kw_discharge_power",
                          "name": "Discharge",
                          "unit": "kW"
                        },
                        {
                          "entity": "input_number.charge_power_deye_5kw",
                          "name": "Charge",
                          "unit": "kW"
                        }
                      ],
                      "secondary_info": {
                        "entity": "sensor.deye_5kw_battery_cycles",
                        "name": "Cycles:",
                        "unit": false,
                        "format": "precision0"
                      },
                      "card_mod": {
                        "style": {
                          "hui-generic-entity-row $": ".info {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n.secondary {\n  order: -1;\n  font-size: 10px;\n  line-height: 12px;\n}\n",
                          ".": ".entity {\n  flex: 0 0 56px !important;\n  width: 56px;\n  margin: 0 0 0 6px !important;\n  text-align: center;\n  white-space: nowrap;\n  position: relative;\n  left: 6px;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "custom:multiple-entity-row",
                      "entity": "input_datetime.deye_morning_export_start_time",
                      "name": "Selling",
                      "icon": "mdi:clock",
                      "show_state": false,
                      "state_color": false,
                      "entities": [
                        {
                          "entity": "input_datetime.deye_morning_export_start_time",
                          "name": "Start"
                        },
                        {
                          "entity": "input_datetime.deye_max_solar_start_time",
                          "name": "Update"
                        },
                        {
                          "entity": "input_number.deye_5kw_surplus_power_threshold",
                          "name": "Load on",
                          "unit": "kW",
                          "styles": {
                            "color": "var(--success-color, #4caf50)"
                          }
                        }
                      ],
                      "card_mod": {
                        "style": ".entity {\n  flex: 0 0 56px !important;\n  width: 56px;\n  margin: 0 0 0 6px !important;\n  text-align: center;\n  white-space: nowrap;\n  position: relative;\n  left: 6px;\n}\n"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Deye 6KW:",
                  "heading_style": "title",
                  "card_mod": {
                    "style": ".title .heading::after {\n  content: \" {{ states('sensor.deye_6kw_device_state') }}\";\n  color: {% set s = states('sensor.deye_6kw_device_state') %}{% if s == 'Normal' and is_state('select.deye_6kw_battery_operation_mode', 'No Battery') %}var(--green-color, #4caf50){% elif s == 'Normal' %}var(--amber-color, #ffc107){% elif s == 'Standby' %}var(--blue-color, #2196f3){% elif s in ['Fault', 'Alarm'] %}var(--red-color, #f44336){% elif s == 'Self-test' %}var(--purple-color, #9c27b0){% else %}var(--disabled-text-color, #9e9e9e){% endif %};\n}"
                  }
                },
                {
                  "type": "custom:sunsynk-power-flow-card",
                  "cardstyle": "lite",
                  "show_solar": true,
                  "battery": {
                    "energy": 0,
                    "shutdown_soc": "input_number.deye_6kw_min_soc",
                    "show_daily": true
                  },
                  "solar": {
                    "show_daily": true,
                    "mppts": 2
                  },
                  "load": {
                    "show_daily": true
                  },
                  "grid": {
                    "show_daily_buy": true,
                    "show_daily_sell": true,
                    "show_nonessential": true
                  },
                  "entities": {
                    "inverter_voltage_154": "sensor.deye_6kw_grid_l1_voltage",
                    "load_frequency_192": "sensor.deye_6kw_grid_frequency",
                    "inverter_current_164": "sensor.deye_6kw_grid_l1_current",
                    "grid_connected_status_194": "binary_sensor.deye_6kw_grid",
                    "day_battery_charge_70": "sensor.deye_6kw_today_battery_charge",
                    "day_battery_discharge_71": "sensor.deye_6kw_today_battery_discharge",
                    "battery_voltage_183": "sensor.deye_6kw_battery_voltage",
                    "battery_soc_184": "sensor.deye_6kw_battery",
                    "battery_power_190": "sensor.deye_6kw_battery_power",
                    "battery_current_191": "sensor.deye_6kw_battery_current",
                    "grid_power_169": "binary_sensor.deye_6kw_grid",
                    "day_grid_import_76": "sensor.deye_6kw_today_energy_import",
                    "day_grid_export_77": "sensor.deye_6kw_today_energy_export",
                    "grid_ct_power_172": "sensor.deye_6kw_grid_power",
                    "day_load_energy_84": "sensor.deye_6kw_today_load_consumption",
                    "essential_power": "sensor.deye_6kw_load_power",
                    "nonessential_power": "none",
                    "aux_power_166": "sensor.boiler_ten_power_estimate",
                    "day_pv_energy_108": "sensor.deye_6kw_today_production",
                    "pv1_power_186": "sensor.deye_6kw_pv1_power",
                    "pv2_power_187": "sensor.deye_6kw_pv2_power",
                    "pv1_voltage_109": "sensor.deye_6kw_pv1_voltage",
                    "pv1_current_110": "sensor.deye_6kw_pv1_current",
                    "pv2_voltage_111": "sensor.deye_6kw_pv2_voltage",
                    "pv2_current_112": "sensor.deye_6kw_pv2_current",
                    "battery_temp_182": "sensor.deye_6kw_battery_temperature",
                    "inverter_temp_153": "sensor.deye_6kw_temperature",
                    "day_aux_energy": "sensor.boiler_ten_energy_estimate_daily"
                  },
                  "show_aux": true,
                  "aux_type": "boiler",
                  "aux_name": "Boiler",
                  "show_daily_aux": true,
                  "card_mod": {
                    "style": "ha-card {\n  border-bottom-left-radius: 0 !important;\n  border-bottom-right-radius: 0 !important;\n  border-bottom: none !important;\n}\n/* Per-string daily PV energy next to the PV1/PV2 boxes (packages/energy/pv_strings.yaml).\n   Positions are in SVG viewBox units (490 wide) converted to cqw. */\nha-card {\n  container-type: inline-size;\n}\nha-card::before,\nha-card::after {\n  position: absolute;\n  top: 13.2cqw;\n  font: 2.65cqw/1 Roboto, Noto, sans-serif;\n  color: {{ '#FFA500' if (states('sensor.deye_6kw_pv1_power') | float(0) + states('sensor.deye_6kw_pv2_power') | float(0)) > 10 else 'grey' }};\n  pointer-events: none;\n}\nha-card::before {\n  content: \"{{ '%.1f' | format(states('sensor.deye_6kw_pv1_energy_daily') | float(0)) }} kWh\";\n  right: 69.6cqw;\n}\nha-card::after {\n  content: \"{{ '%.1f' | format(states('sensor.deye_6kw_pv2_energy_daily') | float(0)) }} kWh\";\n  left: 67.8cqw;\n}\n/* Installed panel power inside the PV1/PV2 boxes, above the live power */\n.container::before,\n.container::after {\n  position: absolute;\n  top: 11.9cqw;\n  font: 1.63cqw/1 Roboto, Noto, sans-serif;\n  color: {{ '#FFA500' if (states('sensor.deye_6kw_pv1_power') | float(0) + states('sensor.deye_6kw_pv2_power') | float(0)) > 10 else 'grey' }};\n  transform: translateX(-50%);\n  pointer-events: none;\n}\n.container::before {\n  content: \"4.1 kW\";\n  left: 38.8cqw;\n}\n.container::after {\n  content: \"2.05 kW\";\n  left: 59.5cqw;\n}\n#pv1_power_186,\n#pv2_power_187 {\n  transform: translateY(4px);\n}\n"
                  }
                },
                {
                  "type": "entities",
                  "card_mod": {
                    "style": "ha-card {\n  margin-top: -8px;\n  border-top-left-radius: 0 !important;\n  border-top-right-radius: 0 !important;\n  border-top: 1px solid var(--divider-color) !important;\n}\n"
                  },
                  "entities": [
                    {
                      "entity": "switch.deye_6kw_grid_peak_shaving",
                      "name": "Peak shaving",
                      "icon": "mdi:transmission-tower-import",
                      "card_mod": {
                        "style": {
                          ".": ":host {\n  display: block;\n  margin: -2px 0;\n}\n{% if is_state('input_select.deye_system_state', 'Idle') and not (states('input_datetime.deye_morning_export_start_time') <= now().strftime('%H:%M:%S') < states('input_datetime.deye_night_idle_start_time')) %}\n:host {\n  pointer-events: none;\n  opacity: 0.45;\n}\n{% endif %}\n",
                          "hui-generic-entity-row $": ".row {\n  height: 28px;\n  min-height: 28px;\n}\nstate-badge {\n  height: 28px;\n  --mdc-icon-size: 22px;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "custom:multiple-entity-row",
                      "entity": "input_number.deye_6kw_min_soc",
                      "name": "Battery",
                      "icon": "mdi:battery-charging",
                      "show_state": false,
                      "state_color": false,
                      "entities": [
                        {
                          "entity": "input_number.deye_6kw_min_soc",
                          "name": "Min SOC",
                          "unit": "%",
                          "format": "precision0"
                        },
                        {
                          "entity": "input_number.deye_6kw_discharge_power",
                          "name": "Discharge",
                          "unit": "kW"
                        },
                        {
                          "entity": "input_number.charge_power_deye_6kw",
                          "name": "Charge",
                          "unit": "kW"
                        }
                      ],
                      "secondary_info": {
                        "entity": "sensor.deye_6kw_battery_cycles",
                        "name": "Cycles:",
                        "unit": false,
                        "format": "precision0"
                      },
                      "card_mod": {
                        "style": {
                          "hui-generic-entity-row $": ".info {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n.secondary {\n  order: -1;\n  font-size: 10px;\n  line-height: 12px;\n}\n",
                          ".": ".entity {\n  flex: 0 0 56px !important;\n  width: 56px;\n  margin: 0 0 0 6px !important;\n  text-align: center;\n  white-space: nowrap;\n  position: relative;\n  left: 6px;\n}\n.entity:nth-of-type(3) > div {\n  color: {{ 'var(--amber-color, #ffc107)' if states('input_number.charge_power_deye_6kw') | float(0) > 0 else 'var(--primary-text-color)' }};\n}\n"
                        }
                      }
                    },
                    {
                      "type": "custom:multiple-entity-row",
                      "entity": "input_datetime.deye_evening_export_start_time",
                      "name": "Selling",
                      "icon": "mdi:clock",
                      "show_state": false,
                      "state_color": false,
                      "entities": [
                        {
                          "entity": "input_datetime.deye_evening_export_start_time",
                          "name": "Update"
                        },
                        {
                          "entity": "input_datetime.deye_night_idle_start_time",
                          "name": "Stop"
                        },
                        {
                          "entity": "input_number.deye_load_off_power_threshold",
                          "name": "Load off",
                          "unit": "kW",
                          "styles": {
                            "color": "var(--error-color, #f44336)"
                          }
                        }
                      ],
                      "card_mod": {
                        "style": ".entity {\n  flex: 0 0 56px !important;\n  width: 56px;\n  margin: 0 0 0 6px !important;\n  text-align: center;\n  white-space: nowrap;\n  position: relative;\n  left: 6px;\n}\n"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "custom:power-flow-card-plus",
                  "entities": {
                    "home": {
                      "entity": "sensor.home_load_energy_daily",
                      "override_state": true
                    },
                    "grid": {
                      "entity": {
                        "consumption": "sensor.total_today_grid_import",
                        "production": "sensor.total_today_grid_export"
                      }
                    },
                    "solar": {
                      "entity": "sensor.total_today_pv_production"
                    },
                    "battery": {
                      "entity": {
                        "consumption": "sensor.total_battery_today_discharge",
                        "production": "sensor.total_battery_today_charge"
                      }
                    },
                    "individual": [
                      {
                        "entity": "sensor.boiler_ten_energy_estimate_daily",
                        "name": "Boiler",
                        "icon": "mdi:water-boiler",
                        "display_zero": true
                      },
                      {
                        "entity": "sensor.washer_energy_today",
                        "name": "Washer",
                        "icon": "mdi:washing-machine",
                        "display_zero": true,
                        "secondary_info": {
                          "entity": "sensor.washer_power",
                          "unit_of_measurement": "W",
                          "display_zero": false
                        }
                      },
                      {
                        "entity": "sensor.bizon_energy_today",
                        "name": "Bizon",
                        "icon": "mdi:desktop-tower-monitor",
                        "display_zero": true,
                        "secondary_info": {
                          "entity": "sensor.bizon_power",
                          "unit_of_measurement": "W",
                          "display_zero": false
                        }
                      }
                    ]
                  },
                  "unit_of_measurement": "Wh",
                  "watt_threshold": 1000,
                  "display_zero_lines": true,
                  "disable_dots": true,
                  "visibility": [
                    {
                      "condition": "or",
                      "conditions": [
                        {
                          "condition": "screen",
                          "media_query": "(min-width: 768px)"
                        },
                        {
                          "condition": "state",
                          "entity": "input_boolean.home_combined_flow_expanded",
                          "state": "on"
                        }
                      ]
                    }
                  ],
                  "card_mod": {
                    "style": ".card-content {\n  padding: 0 16px !important;\n  margin: -1px 0 !important;\n}\n"
                  }
                },
                {
                  "type": "entities",
                  "show_header_toggle": false,
                  "entities": [
                    {
                      "entity": "automation.power_load_cascade",
                      "card_mod": {
