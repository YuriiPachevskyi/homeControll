                              ".": "ha-card { --tile-color: var(--amber-color) !important; border: none; background: color-mix(in srgb, var(--amber-color) 12%, transparent); height: 100%; min-height: 0 !important; }\nha-tile-icon { --tile-icon-size: 22px; --mdc-icon-size: 16px; height: 22px; width: 22px; }\nha-tile-info { --tile-info-primary-font-size: 10px; --tile-info-primary-line-height: 12px; }\n",
                              "ha-tile-container $": ".content { padding: 3px 2px !important; gap: 0 !important; }"
                            }
