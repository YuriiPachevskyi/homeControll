                            "min": 0,
                            "max": "~15",
                            "decimals": 1,
                            "apex_config": {
                              "tickAmount": 6,
                              "title": {
                                "text": "грн"
                              }
                            }
                          }
                        ],
                        "series": [
                          {
                            "entity": "sensor.total_pv_power",
                            "name": "Сонце",
                            "yaxis_id": "power",
                            "type": "column",
                            "stack_group": "solar",
                            "color": "#ff9800",
                            "show": {
                              "extremas": true
                            },
                            "group_by": {
                              "func": "avg",
                              "duration": "1h"
                            },
                            "transform": "return x / 1000;",
                            "unit": "kW",
                            "float_precision": 2
                          },
                          {
                            "entity": "sensor.total_grid_power_realtime",
                            "name": "Продаж",
                            "yaxis_id": "power",
                            "type": "column",
                            "stack_group": "grid",
                            "color": "#4caf50",
                            "transform": "return x < 0 ? -x / 1000 : 0;",
                            "show": {
                              "extremas": false
                            },
                            "group_by": {
                              "func": "avg",
                              "duration": "1h"
                            },
                            "unit": "kW",
                            "float_precision": 2
                          },
                          {
                            "entity": "sensor.total_battery_power_realtime",
                            "name": "Розряд",
                            "yaxis_id": "power",
                            "type": "column",
                            "stack_group": "battery",
                            "color": "#9c27b0",
                            "transform": "return x > 0 ? x / 1000 : 0;",
                            "show": {
                              "extremas": false
                            },
                            "group_by": {
                              "func": "avg",
                              "duration": "1h"
                            },
                            "unit": "kW",
                            "float_precision": 2
                          },
                          {
                            "entity": "sensor.total_battery_power_realtime",
                            "name": "Заряд",
                            "yaxis_id": "power",
                            "type": "column",
                            "stack_group": "battery",
                            "color": "#00bcd4",
                            "transform": "return x < 0 ? -x / 1000 : 0;",
                            "show": {
                              "extremas": false
                            },
                            "group_by": {
                              "func": "avg",
                              "duration": "1h"
                            },
                            "unit": "kW",
                            "float_precision": 2
                          },
                          {
                            "entity": "sensor.total_load_power_realtime",
                            "name": "Будинок",
                            "yaxis_id": "power",
                            "type": "line",
                            "color": "#e53935",
                            "stroke_width": 3,
                            "curve": "smooth",
                            "extend_to": false,
                            "show": {
                              "extremas": false
                            },
                            "group_by": {
                              "func": "avg",
                              "duration": "1h"
                            },
                            "transform": "return x / 1000;",
                            "unit": "kW",
                            "float_precision": 2
                          },
                          {
                            "entity": "sensor.total_grid_power_realtime",
