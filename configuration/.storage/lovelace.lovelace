                    }
                  },
                  {
                    "type": "markdown",
                    "title": null,
                    "content": "#### <ha-icon icon=\"mdi:jellyfish\"></ha-icon> Jellyfin\n{% for l in states('sensor.jellyfin_now_playing').split('\\n') if l %}{% set f = l.split('\\t') %}{% set p = f[3] | int(0) %}{% set fill = (p + 4) // 5 %}<ha-icon icon=\"{{ 'mdi:pause-circle' if f[2] == '1' else 'mdi:play-circle' }}\"></ha-icon> **{{ f[0] }}** · {{ f[1] }}\n{% if fill %}`{{ '━' * fill }}`{% endif %}<sub>{{ '━' * (20 - fill) }}</sub> <small>{{ p }}%{% if f[4] %} · {{ f[4] }}{% endif %}</small>\n\n{% endfor %}",
                    "visibility": [
