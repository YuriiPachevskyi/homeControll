                                "hui-energy-period-selector$": ".row { min-height: 40px !important; }\n.header-title { font-size: 16px !important; font-weight: 400 !important; line-height: 24px !important; }\nha-icon-button { --mdc-icon-size: 18px; --mdc-icon-button-size: 28px; --ha-icon-button-size: 28px; color: var(--secondary-text-color); }\nha-date-range-picker { --mdc-icon-size: 18px; --mdc-icon-button-size: 28px; --ha-icon-button-size: 28px; color: var(--secondary-text-color); }\nha-button { --ha-button-height: 26px; --ha-button-font-size: 13px; }"
                              }
