              "card_mod": {
                "style": "ha-card { background: var(--ha-card-background, var(--card-background-color)); border: 1px solid var(--ha-card-border-color, var(--divider-color)); border-radius: var(--ha-card-border-radius, 12px); padding: 4px 8px 8px; }"
              }
            }
          ]
        },
        {
          "type": "sidebar",
          "path": "dap",
          "cards": [
            {
              "type": "custom:mod-card",
              "card": {
                "type": "horizontal-stack",
                "cards": [
                  {
                    "type": "vertical-stack",
                    "cards": [
                      {
                        "type": "vertical-stack",
                        "cards": [
                          {
                            "type": "heading",
                            "heading": "Ціна РДН по годинах",
                            "heading_style": "title",
                            "icon": "mdi:cash-clock",
                            "badges": [
                              {
                                "type": "entity",
                                "entity": "input_datetime.dam_price_day",
                                "icon": "mdi:chevron-left",
                                "show_state": false,
                                "show_icon": true,
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "script.dam_price_day_shift",
                                  "data": {
                                    "days": -1
                                  }
                                }
                              },
                              {
                                "type": "entity",
                                "entity": "input_datetime.dam_price_day",
                                "icon": "mdi:calendar",
                                "show_state": false,
                                "show_icon": true,
                                "tap_action": {
                                  "action": "fire-dom-event",
                                  "date_pick_entity": "input_datetime.dam_price_day"
                                }
                              },
                              {
                                "type": "entity",
                                "entity": "input_datetime.dam_price_day",
                                "icon": "mdi:calendar-today",
                                "show_state": false,
                                "show_icon": true,
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "script.dam_price_day_shift",
                                  "data": {
                                    "days": 0
                                  }
                                }
                              },
                              {
                                "type": "entity",
                                "entity": "input_datetime.dam_price_day",
                                "icon": "mdi:chevron-right",
                                "show_state": false,
                                "show_icon": true,
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "script.dam_price_day_shift",
                                  "data": {
                                    "days": 1
                                  }
                                }
                              },
                              {
                                "type": "entity",
                                "entity": "input_boolean.dam_price_table_expanded",
                                "icon": "mdi:arrow-expand-vertical",
                                "show_state": false,
                                "show_icon": true,
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "input_boolean.toggle",
                                  "target": {
                                    "entity_id": "input_boolean.dam_price_table_expanded"
                                  }
                                },
                                "visibility": [
                                  {
                                    "condition": "state",
                                    "entity": "input_boolean.dam_price_table_expanded",
                                    "state": "off"
                                  }
                                ]
                              },
                              {
                                "type": "entity",
                                "entity": "input_boolean.dam_price_table_expanded",
                                "icon": "mdi:arrow-collapse-vertical",
                                "show_state": false,
                                "show_icon": true,
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "input_boolean.toggle",
                                  "target": {
                                    "entity_id": "input_boolean.dam_price_table_expanded"
                                  }
                                },
                                "visibility": [
                                  {
                                    "condition": "state",
                                    "entity": "input_boolean.dam_price_table_expanded",
                                    "state": "on"
                                  }
                                ]
                              }
                            ],
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "input_boolean.toggle",
                              "target": {
                                "entity_id": "input_boolean.dam_price_table_expanded"
                              }
                            }
                          },
                          {
                            "type": "markdown",
                            "content": "{%- set s = 'sensor.dam_price_day' -%}\n{%- set expanded = is_state('input_boolean.dam_price_table_expanded', 'on') -%}\n{%- set live = 'sensor.dap_ua_average_electricity_price' -%}\n{%- set sel = states('input_datetime.dam_price_day') -%}\n{%- set is_today = sel in ['unknown', 'unavailable', ''] or sel >= now().date() | string -%}\n{%- set day = now() if is_today else sel | as_datetime -%}\n{%- set wd = ['пн', 'вт', 'ср', 'чт', 'пт', 'сб', 'нд'][day.weekday()] -%}\n{%- set loaded = states(s) == day.strftime('%Y-%m-%d') -%}\n{%- set en = (state_attr(s, 'energy') or {}) if loaded else {} -%}\n{%- set ns = namespace(a=[], b=[], starts=[], left=[], ex=0, ho=0, im=0) -%}\n{%- if is_today -%}\n{%- for p in state_attr(live, 'prices_today') or [] -%}{%- set ns.a = ns.a + [[p.time[11:16], p.price]] -%}{%- endfor -%}\n{%- for p in state_attr(live, 'prices_tomorrow') or [] -%}{%- set ns.b = ns.b + [p.price] -%}{%- endfor -%}\n{%- set avg_a = states(live) | float(none) -%}\n{%- elif loaded -%}\n{%- set ns.a = state_attr(s, 'hours') or [] -%}\n{%- set avg_a = state_attr(s, 'avg') -%}\n{%- endif -%}\n{%- set a = ns.a -%}{%- set b = ns.b -%}\n**{{ wd }}, {{ day.strftime('%d.%m.%Y') }}**{% if is_today %} · сьогодні{% endif %}\n\n{% if not a -%}\n{%- if not is_today and not loaded %}_Завантаження…_{% elif state_attr(s, 'error') and not is_today %}_Немає даних: {{ state_attr(s, 'error') }}_{% else %}_Немає даних_{% endif %}\n{%- else -%}\n{#- a new row starts wherever a price changes; energy of merged hours is summed -#}\n{%- for i in range(a | count) -%}\n{%- set m = b[i] if b | count > i else none -%}\n{%- set pm = b[i - 1] if i > 0 and b | count >= i else none -%}\n{%- if i == 0 or a[i][1] != a[i - 1][1] or m != pm -%}{%- set ns.starts = ns.starts + [i] -%}{%- endif -%}\n{%- endfor -%}\n{%- set bounds = ns.starts + [a | count] -%}\n{%- set h = now().strftime('%H:00') -%}\n{%- for k in range(ns.starts | count) -%}\n{%- set i = bounds[k] -%}{%- set j = bounds[k + 1] -%}\n{%- set end = a[j][0] if j < a | count else '24:00' -%}\n{%- set x = '**' if is_today and a[i][0] <= h < end else '' -%}\n{%- set m = b[i] if b | count > i else none -%}\n{%- set e = namespace(ex=none, ho=none, im=none) -%}\n{%- for q in range(i, j) -%}{%- set v = en.get(a[q][0]) -%}\n{%- if v and v[0] is not none -%}{%- set e.ex = (e.ex or 0) + v[0] -%}{%- endif -%}\n{%- if v and v[1] is not none -%}{%- set e.ho = (e.ho or 0) + v[1] -%}{%- endif -%}\n{%- if v and v | count > 2 and v[2] is not none -%}{%- set e.im = (e.im or 0) + v[2] -%}{%- endif -%}\n{%- endfor -%}\n{%- set ns.ex = ns.ex + (e.ex or 0) -%}{%- set ns.ho = ns.ho + (e.ho or 0) -%}{%- set ns.im = ns.im + (e.im or 0) -%}\n{%- set fex = '–' if e.ex is none else ('·' if e.ex < 0.05 else '%.1f' % e.ex) -%}\n{%- set fim = '–' if e.im is none else ('·' if e.im < 0.05 else '%.1f' % e.im) -%}\n{%- set fho = '–' if e.ho is none else ('·' if e.ho < 0.05 else '%.1f' % e.ho) -%}\n{%- set cells = x ~ a[i][0] ~ ('–' ~ end if j - i > 1 else '') ~ x ~ ' | ' ~ x ~ ('%.2f' % a[i][1]) ~ x ~ (' | ' ~ ('%.2f' % m if m is not none else '–') if b else '') ~ ' | ' ~ fex ~ ' | ' ~ fim ~ ' | ' ~ fho -%}\n{%- set ns.left = ns.left + [cells] -%}\n{%- endfor -%}\n{%- set u = '' -%}\n{%- set k = '' -%}\n{%- set ic = '<ha-icon icon=\"mdi:%s\"></ha-icon> ' -%}\n{%- set head = ic % 'clock-outline' ~ 'Година | ' ~ ic % 'cash' ~ ('Сьогодні' if is_today else 'Ціна') ~ u ~ (' | ' ~ ic % 'cash-clock' ~ 'Завтра' ~ u if b else '') ~ ' | ' ~ ic % 'transmission-tower-export' ~ 'Експ.' ~ k ~ ' | ' ~ ic % 'transmission-tower-import' ~ 'Імп.' ~ k ~ ' | ' ~ ic % 'home-lightning-bolt' ~ 'Буд.' ~ k -%}\n{%- set align = ':-- | --:' ~ (' | --:' if b else '') ~ ' | --: | --: | --:' -%}\n{%- set total = '**Сер. / Σ** | **' ~ ('%.2f' % avg_a if avg_a is not none else '–') ~ '**' ~ (' | **' ~ ('%.2f' % (b | sum / b | count)) ~ '**' if b else '') ~ ' | **' ~ ('%.1f' % ns.ex) ~ '** | **' ~ ('%.1f' % ns.im) ~ '** | **' ~ ('%.1f' % ns.ho) ~ '**' -%}\n\n| {{ head }} |\n| {{ align }} |\n{% for r in ns.left if expanded or r.startswith('**') -%}\n| {{ r }} |\n{% endfor -%}\n| {{ total }} |\n{%- endif %}\n\nціна ₴/кВт·год · енергія кВт·год · «·» менше 0,05 · «–» ще немає даних",
                            "card_mod": {
                              "style": {
                                "ha-markdown $": "table { width: 100%; table-layout: fixed; border-collapse: collapse; margin: 0 !important; }\nth:nth-child(1), td:nth-child(1) { width: 20%; }\nth:nth-child(2), td:nth-child(2) { width: 18%; }\nth, td { padding: 3px 6px !important; text-align: right; white-space: nowrap; }\nth, th:first-child { font-weight: bold; text-align: left !important; vertical-align: middle; }\ntd:first-child { text-align: left; font-weight: bold; }\nha-icon { --mdc-icon-size: 16px; vertical-align: text-bottom; }\n@media (max-width: 767px) { table { font-size: 11px; table-layout: auto; } th:nth-child(1), td:nth-child(1), th:nth-child(2), td:nth-child(2) { width: auto; } th, td { padding: 2px 3px !important; } ha-icon { --mdc-icon-size: 14px; } th { white-space: normal; } }\nha-icon[icon=\"mdi:cash\"], ha-icon[icon=\"mdi:cash-clock\"] { color: #9c27b0; }\nha-icon[icon=\"mdi:transmission-tower-export\"] { color: #4caf50; }\nha-icon[icon=\"mdi:home-lightning-bolt\"] { color: #ff9800; }\nha-icon[icon=\"mdi:clock-outline\"] { color: var(--secondary-text-color); }\nha-icon[icon=\"mdi:transmission-tower-import\"] { color: #44739e; }\n"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "type": "custom:apexcharts-card",
                        "header": {
                          "show": true,
                          "title": "Енергія та ціна по годинах",
                          "show_states": false,
                          "colorize_states": true
                        },
                        "graph_span": "24h",
                        "span": {
                          "start": "day"
                        },
                        "now": {
                          "show": true,
                          "label": "Зараз",
                          "color": "#e53935"
                        },
                        "cache": true,
                        "update_delay": "30000ms",
                        "apex_config": {
                          "chart": {
                            "type": "bar",
                            "height": "350px",
                            "stacked": true,
                            "toolbar": {
                              "show": false
                            },
                            "zoom": {
                              "enabled": false
