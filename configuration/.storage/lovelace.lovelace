                          "icon_color": "{% set s = states('sensor.deye_6kw_device_state') %}{% if s == 'Normal' and is_state('select.deye_6kw_battery_operation_mode', 'No Battery') %}green{% elif s == 'Normal' %}yellow{% elif s == 'Standby' %}blue{% endif %}"
