                          "ha-select $ ha-picker-field $": "ha-combo-box-item {\n  min-height: 44px !important;\n  height: 44px !important;\n}\nspan[slot=overline] {\n  visibility: hidden;\n  position: relative;\n}\nspan[slot=overline]::after {\n  visibility: visible;\n  position: absolute;\n  left: 0;\n  top: 0;\n  max-width: calc(100vw - 140px);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  content: \"{% set soc5 = states('input_number.deye_5kw_export_soc') | int(0) %}{% set st = states('input_select.deye_system_state') %}{% if is_state('input_select.selling_mode', 'Save + Night Charge') and (now().strftime('%H:%M') >= '23:10' or now().strftime('%H:%M') < '06:30') %}Заряд 5kW з мережі до 100 %{% elif is_state('input_select.selling_mode', 'Save + Night Charge') %}{{ '5kW повна, продаж лишку' if states('input_number.export_deye_5kw_power_base') | float(0) > 100 else 'PV у батарею, 5kW до ' ~ soc5 ~ ' %' }}{% elif is_state('input_select.selling_mode', 'Save') %}{{ 'Save: 5kW повна, продаж лишку' if states('input_number.export_deye_5kw_power_base') | float(0) > 100 else 'Save: PV у батарею, 5kW до ' ~ soc5 ~ ' %' }}{% elif is_state('input_select.selling_mode', 'Force') and st in ['Morning Export', 'Max Solar'] %}Force: 5kW до 40 %, 6kW до 55 %{% elif st == 'Morning Export' %}5kW продає до {{ soc5 }} %{% elif st == 'Max Solar' %}Продаж, надлишок у батарею і бойлер{% elif st == 'Evening Export' %}5kW до {{ soc5 }} %, 6kW {{ 'до ' ~ states('input_number.deye_6kw_export_soc') | int(0) ~ ' %' if is_state('input_boolean.deye_6kw_battery_selling', 'on') else 'не продає' }}{% else %}Без продажу, батареї на дім{% endif %}\";\n}\n",
