                        "title": "Ціни РДН, грн/кВт·год"
                      },
                      {
                        "type": "custom:day-offset-card",
                        "history_days": 5,
                        "card": {
                          "type": "custom:apexcharts-card",
                          "graph_span": "24h",
                          "span": {
                            "start": "day"
                          },
                          "now": {
                            "show": true,
                            "color": "#e53935"
                          },
                          "header": {
                            "show": true,
                            "title": "Напруга: мережа та стабілізована",
                            "show_states": true,
                            "colorize_states": true
                          },
                          "apex_config": {
                            "chart": {
                              "height": 350
                            },
                            "stroke": {
                              "width": 2,
                              "curve": "smooth"
                            },
                            "legend": {
                              "show": true,
                              "position": "bottom"
                            },
                            "tooltip": {
                              "shared": true,
                              "intersect": false
                            },
                            "annotations": {
                              "yaxis": [
                                {
                                  "y": 230,
                                  "borderColor": "#e67e22",
                                  "strokeDashArray": 4,
                                  "label": {
                                    "text": "Номінал 230V",
                                    "textAnchor": "start",
                                    "style": {
                                      "color": "#fff",
                                      "background": "#e67e22"
                                    }
                                  }
                                }
                              ]
                            }
                          },
                          "yaxis": [
                            {
                              "id": "voltage",
                              "min": 160,
                              "max": 260,
                              "decimals": 0,
                              "apex_config": {
                                "tickAmount": 5,
                                "title": {
                                  "text": "В"
                                }
                              }
                            },
                            {
                              "id": "power",
                              "min": 0,
                              "max": 5000,
                              "decimals": 0,
                              "opposite": true,
                              "apex_config": {
                                "tickAmount": 5,
                                "title": {
                                  "text": "Вт"
                                }
                              }
                            }
                          ],
                          "series": [
                            {
                              "entity": "sensor.deye_6kw_grid_l1_voltage",
                              "name": "Вхідна напруга (Deye 6kW / 5kW)",
                              "yaxis_id": "voltage",
                              "type": "line",
                              "color": "#3498db",
                              "extend_to": false,
                              "float_precision": 1,
                              "show": {
                                "legend_value": false,
                                "in_header": "before_now"
                              },
                              "data_generator": "const ids = ['sensor.deye_6kw_grid_l1_voltage', 'sensor.deye_5kw_grid_l1_voltage'];\nconst day0 = new Date(); day0.setHours(0, 0, 0, 0); day0.setDate(day0.getDate() - 5);\nif (+start <= day0.getTime() + 1000) {\n  // Older than recorder history: hourly statistics, 6kW mean unless it dipped below 150 V.\n  const st = await hass.callWS({type: 'recorder/statistics_during_period',\n    start_time: start.toISOString(), end_time: end.toISOString(),\n    statistic_ids: ids, period: 'hour', types: ['mean', 'min']});\n  const a = new Map((st[ids[0]] || []).map(x => [x.start, x]));\n  const b = new Map((st[ids[1]] || []).map(x => [x.start, x]));\n  const ts = [...new Set([...a.keys(), ...b.keys()])].sort((x, y) => x - y);\n  return ts.map(t => {\n    const x = a.get(t), y = b.get(t);\n    const v = (x && x.min !== null && x.min >= 150) ? x.mean : (y ? y.mean : (x ? x.mean : null));\n    return [t, v];\n  });\n}\nconst res = await hass.callWS({type: 'history/history_during_period',\n  start_time: start.toISOString(), end_time: end.toISOString(),\n  entity_ids: ids, minimal_response: true, no_attributes: true,\n  significant_changes_only: false});\nconst pts = [];\nids.forEach((id, k) => (res[id] || []).forEach(s => {\n  const v = parseFloat(s.s);\n  pts.push([Math.round((s.lu ?? s.lc) * 1000), k, isNaN(v) ? null : v]);\n}));\npts.sort((a, b) => a[0] - b[0]);\nconst cur = [null, null], out = [];\n// 5-minute averages (done here, not via group_by: its fill runs past \"now\").\nconst B = 300000, acc = new Map();\nfor (const [t, k, v] of pts) {\n  cur[k] = v;\n  const y = (cur[0] !== null && cur[0] >= 150) ? cur[0] : cur[1];\n  if (y === null) continue;\n  const b = Math.floor(t / B) * B, a = acc.get(b) || [0, 0];\n  a[0] += y; a[1]++; acc.set(b, a);\n}\nfor (const [b, [sum, n]] of acc) out.push([b, sum / n]);\n// Closing point at \"now\" so the header's before_now finds the last bucket.\nif (out.length && +end > Date.now()) out.push([Date.now(), out[out.length - 1][1]]);\nreturn out;"
                            },
                            {
                              "entity": "sensor.breaker_phase_a_voltage",
                              "name": "Стабілізована напруга",
                              "yaxis_id": "voltage",
                              "type": "line",
                              "color": "#2ecc71",
                              "extend_to": false,
                              "float_precision": 1,
                              "group_by": {
                                "func": "avg",
                                "duration": "5m"
                              },
                              "show": {
