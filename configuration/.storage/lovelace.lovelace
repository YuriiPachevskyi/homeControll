                        },
                        {
                          "type": "markdown",
                          "content": "{% set cpu = states('sensor.192_168_1_4_cpu_usage') %}{% set ram = states('sensor.192_168_1_4_memory_usage') %}{% set t = states('sensor.192_168_1_4_tctl_temperature') %}{% set d = states('sensor.192_168_1_4_mnt_wd10t_media_disk_usage') %}{% set w = states('sensor.bizon_power') %}{% macro v(x, u) %}{{ (x | float(0)) | round(0) | int }}{{ u }}{% endmacro %}{% if cpu not in ['unavailable', 'unknown'] %}<div><span><ha-icon icon=\"mdi:cpu-64-bit\"></ha-icon>{{ v(cpu, '%') }}</span><span><ha-icon icon=\"mdi:memory\"></ha-icon>{{ v(ram, '%') }}</span><span><ha-icon icon=\"mdi:harddisk\"></ha-icon>{{ v(d, '%') }}</span>{% if w | is_number %}<span><ha-icon icon=\"mdi:flash\"></ha-icon>{{ v(w, ' W') }}</span>{% endif %}</div>{% else %}<p><ha-icon icon=\"mdi:sleep\"></ha-icon><span>Sleeping</span>{% if w | is_number %}<small>{{ v(w, ' W') }}</small>{% endif %}</p>{% endif %}",
                          "card_mod": {
                            "style": {
                              ".": "ha-card { border: none; box-shadow: none; height: 100%; border-radius: var(--ha-card-border-radius, 12px); background: color-mix(in srgb, var(--primary-color) 8%, transparent); display: flex; align-items: center; }",
                              "ha-markdown": "ha-markdown { padding: 4px 6px !important; width: 100%; }",
                              "ha-markdown $": "div { display: grid; grid-template-columns: auto auto; gap: 0 8px; font-size: 12px; line-height: 17px; white-space: nowrap; }\ndiv ha-icon { --mdc-icon-size: 13px; color: var(--secondary-text-color); margin-right: 2px; vertical-align: -1px; }\np { margin: 0;  display: flex; flex-direction: column; align-items: center; font-size: 11px; color: var(--secondary-text-color); line-height: 14px; }\np ha-icon { --mdc-icon-size: 20px; }\np small { font-size: 10px; }"
                            }
                          }
                        }
                      ]
                    },
                    "card_mod": {
                      "style": {
                        ".": "ha-card { background: none; border: none; box-shadow: none; }",
                        "hui-horizontal-stack-card $": "#root { gap: 4px; align-items: stretch; }\n#root > hui-card > * { margin: 0 !important; }\n#root > hui-card:nth-child(5) > * { flex: 3 1 0 !important; }"
                      }
                    }
                  },
                  {
                    "type": "markdown",
                    "content": "{% set icons = {'wakeup': 'mdi:power', 'suspend': 'mdi:power-sleep', 'reboot': 'mdi:restart', 'poweroff': 'mdi:power-off'} %}{% set names = {'wakeup': 'Wake', 'suspend': 'Sleep', 'reboot': 'Reboot', 'poweroff': 'Off'} %}{% set ev = (state_attr('sensor.bizon_history', 'events') or []) | reverse | list %}{% macro row(e) %}<ha-icon icon=\"{{ icons[e.command] }}\"></ha-icon> {{ e.time }} · {{ names[e.command] }} · <b>{{ e.who }}</b>{% endmacro %}{% if ev | count > 1 %}<details><summary>{{ row(ev[0]) }}</summary>{% for e in ev[1:] %}<div>{{ row(e) }}</div>{% endfor %}</details>{% elif ev %}<div>{{ row(ev[0]) }}</div>{% endif %}",
                    "visibility": [
                      {
                        "condition": "numeric_state",
                        "entity": "sensor.bizon_history",
                        "above": 0
                      }
