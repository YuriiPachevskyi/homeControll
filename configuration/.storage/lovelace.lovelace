            },
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "markdown",
                  "content": "{%- set rows = state_attr('sensor.monthly_energy_table', 'rows') or [] -%}\n{%- set acts = state_attr('sensor.document_links', 'enera') or {} -%}\n<table><tr><th>Період</th><th><ha-icon icon=\"mdi:solar-power-variant\"></ha-icon> Сонце</th><th><ha-icon icon=\"mdi:transmission-tower-export\"></ha-icon> Експ.</th><th><ha-icon icon=\"mdi:transmission-tower-import\"></ha-icon> Імп.</th><th><ha-icon icon=\"mdi:home-lightning-bolt\"></ha-icon> Буд.</th></tr></table>\n{% for s in rows if s.kind == 'sum' -%}\n{%- set y = s.label[-4:] -%}\n<details><summary><table><tr><td><b>{{ y }}</b></td><td><b>{{ (s.solar | round(0) | int) if s.solar is not none else '–' }}</b><br><small>{{ s.potential }} ₴</small></td><td><b>{{ (s.exp | round(0) | int) if s.exp is not none else '–' }}</b><br><small>{{ '%+d' % s.net }} ₴</small></td><td><b>{{ (s.imp | round(0) | int) if s.imp is not none else '–' }}</b></td><td><b>{{ (s.house | round(0) | int) if s.house is not none else '–' }}{% if s.boiler is not none %} <i>({{ s.boiler | round(0) | int }})</i>{% endif %}</b>{% if s.cost_night is defined %}<br><em><ha-icon icon=\"mdi:weather-night\"></ha-icon>{{ s.cost_night }} ₴</em><br><em><ha-icon icon=\"mdi:white-balance-sunny\"></ha-icon>{{ s.cost_day }} ₴</em><br><em><ha-icon icon=\"mdi:solar-power-variant\"></ha-icon>{{ s.cost_solar }} ₴</em>{% endif %}<br><small>{{ s.house_cost }} ₴{% if s.potential > 0 %} ({{ (100 * s.house_cost / s.potential) | round(0) | int }}%){% endif %}</small></td></tr></table></summary><table>\n{% for r in rows if r.kind == 'month' and r.label.split(' ')[1] == y -%}\n{%- set lbl = r.label | replace(' 20', ' ') -%}\n<tr><td>{% if acts.get(r.get('act')) %}<a href=\"{{ acts[r.act] }}\" target=\"_blank\" rel=\"noopener\">{{ lbl }}</a>{% else %}{{ lbl }}{% endif %}</td><td>{{ (r.solar | round(0) | int) if r.solar is not none else '–' }}<br><small>{{ r.potential }} ₴</small></td><td>{{ (r.exp | round(0) | int) if r.exp is not none else '–' }}<br><small>{{ '%+d' % r.net }} ₴</small></td><td>{{ (r.imp | round(0) | int) if r.imp is not none else '–' }}</td><td>{{ (r.house | round(0) | int) if r.house is not none else '–' }}{% if r.boiler is not none %} <i>({{ r.boiler | round(0) | int }})</i>{% endif %}{% if r.cost_night is defined %}<br><em><ha-icon icon=\"mdi:weather-night\"></ha-icon>{{ r.cost_night }} ₴</em><br><em><ha-icon icon=\"mdi:white-balance-sunny\"></ha-icon>{{ r.cost_day }} ₴</em><br><em><ha-icon icon=\"mdi:solar-power-variant\"></ha-icon>{{ r.cost_solar }} ₴</em>{% endif %}<br><small>{{ r.house_cost }} ₴</small></td></tr>\n{% endfor %}<tr><td><b>{{ y }}</b></td><td><b>{{ (s.solar | round(0) | int) if s.solar is not none else '–' }}</b><br><small>{{ s.potential }} ₴</small></td><td><b>{{ (s.exp | round(0) | int) if s.exp is not none else '–' }}</b><br><small>{{ '%+d' % s.net }} ₴</small></td><td><b>{{ (s.imp | round(0) | int) if s.imp is not none else '–' }}</b></td><td><b>{{ (s.house | round(0) | int) if s.house is not none else '–' }}{% if s.boiler is not none %} <i>({{ s.boiler | round(0) | int }})</i>{% endif %}</b>{% if s.cost_night is defined %}<br><em><ha-icon icon=\"mdi:weather-night\"></ha-icon>{{ s.cost_night }} ₴</em><br><em><ha-icon icon=\"mdi:white-balance-sunny\"></ha-icon>{{ s.cost_day }} ₴</em><br><em><ha-icon icon=\"mdi:solar-power-variant\"></ha-icon>{{ s.cost_solar }} ₴</em>{% endif %}<br><small>{{ s.house_cost }} ₴{% if s.potential > 0 %} ({{ (100 * s.house_cost / s.potential) | round(0) | int }}%){% endif %}</small></td></tr></table></details>\n{% endfor -%}\n{% for t in rows if t.kind == 'total' %}<table><tr><td><b>Всього</b></td><td><b>{{ (t.solar | round(0) | int) if t.solar is not none else '–' }}</b><br><small>{{ t.potential }} ₴</small></td><td><b>{{ (t.exp | round(0) | int) if t.exp is not none else '–' }}</b><br><small>{{ '%+d' % t.net }} ₴</small></td><td><b>{{ (t.imp | round(0) | int) if t.imp is not none else '–' }}</b></td><td><b>{{ (t.house | round(0) | int) if t.house is not none else '–' }}{% if t.boiler is not none %} <i>({{ t.boiler | round(0) | int }})</i>{% endif %}</b>{% if t.cost_night is defined %}<br><em><ha-icon icon=\"mdi:weather-night\"></ha-icon>{{ t.cost_night }} ₴</em><br><em><ha-icon icon=\"mdi:white-balance-sunny\"></ha-icon>{{ t.cost_day }} ₴</em><br><em><ha-icon icon=\"mdi:solar-power-variant\"></ha-icon>{{ t.cost_solar }} ₴</em>{% endif %}<br><small>{{ t.house_cost }} ₴{% if t.potential > 0 %} ({{ (100 * t.house_cost / t.potential) | round(0) | int }}%){% endif %}</small></td></tr></table>{% endfor %}\n\n{%- set bm = rows | selectattr('kind', 'eq', 'month') | rejectattr('boiler', 'none') | list | last if rows | selectattr('kind', 'eq', 'month') | rejectattr('boiler', 'none') | list else none -%}\n{%- set month_name = {'Січ': 'Січень', 'Лют': 'Лютий', 'Бер': 'Березень', 'Кві': 'Квітень', 'Тра': 'Травень', 'Чер': 'Червень', 'Лип': 'Липень', 'Сер': 'Серпень', 'Вер': 'Вересень', 'Жов': 'Жовтень', 'Лис': 'Листопад', 'Гру': 'Грудень'} %}{%- if bm %}<p>{% if bm.solar is not none %}<span>{{ month_name[bm.label.split(' ')[0]] }}</span> <ha-icon icon=\"mdi:solar-power-variant\"></ha-icon>: <b><span>{{ bm.solar | round(0) | int }}</span> kWh</b><br>{% endif %}<span>{% if bm.solar is none %}{{ month_name[bm.label.split(' ')[0]] }}{% endif %}</span> <ha-icon icon=\"mdi:transmission-tower-export\"></ha-icon>: <b><span>{{ bm.exp | round(0) | int }}</span> kWh</b>, <em>сальдо:</em> <b><span>{{ (bm.exp - bm.imp) | round(0) | int }}</span> kWh</b>{% if bm.net is not none %} <small>({{ '%+d' % bm.net }} ₴)</small>{% endif %}<br><span></span> <ha-icon icon=\"mdi:home-lightning-bolt\"></ha-icon>: <b><span>{{ bm.house | round(0) | int }}</span> kWh</b>, <em>з них <ha-icon icon=\"mdi:water-boiler\"></ha-icon>:</em> <b><span>{{ bm.boiler | round(0) | int }}</span> kWh</b>{% if bm.washer is defined and bm.washer is not none %}, <ha-icon icon=\"mdi:washing-machine\"></ha-icon>: <b><span>{{ bm.washer | round(1) }}</span> kWh</b>{% endif %}{% if now().day != 1 %}<br><span>Сьогодні</span> <ha-icon icon=\"mdi:home-lightning-bolt\"></ha-icon>: <b><span>{{ states('sensor.home_load_energy_daily') | float(0) | round(0) | int }}</span> kWh</b>, <em>з них <ha-icon icon=\"mdi:water-boiler\"></ha-icon>:</em> <b><span>{{ states('sensor.boiler_ten_energy_estimate_daily') | float(0) | round(0) | int }}</span> kWh</b>, <ha-icon icon=\"mdi:washing-machine\"></ha-icon>: <b><span>{{ states('sensor.washer_energy_today') | float(0) | round(1) }}</span> kWh</b>{% endif %}</p>\n\n{% endif %}",
                  "card_mod": {
                    "style": {
                      "ha-markdown $": "table { width: 100%; table-layout: fixed; border-collapse: collapse; margin: 0 !important; }\nth:nth-child(2), td:nth-child(2) { width: 20.75%; }\nth:nth-child(3), td:nth-child(3) { width: 20.75%; }\nth:nth-child(4), td:nth-child(4) { width: 15.56%; }\nth:nth-child(5), td:nth-child(5) { width: 25.94%; }\nth, td { padding: 2px 2px !important; text-align: right; }\nth:first-child, td:first-child { width: 17%; text-align: left; white-space: nowrap; }\nth, td { border: 1px solid var(--divider-color) !important; border-top: none !important; white-space: nowrap; box-sizing: border-box; }\nth { border-top: 1px solid var(--divider-color) !important; }\nth { font-weight: normal; vertical-align: bottom; text-align: right !important; }\nth:first-child { text-align: left !important; }\ntd small { color: var(--secondary-text-color); }\ni { font-style: normal; color: #66bb6a; }\ntd em { font-style: normal; font-size: smaller; white-space: nowrap; }\ntd em ha-icon[icon] { --mdc-icon-size: 12px; color: inherit; margin-right: 2px; }\ntd em:nth-of-type(1) { color: #5c6bc0; }\ntd em:nth-of-type(2) { color: #ef6c00; }\ntd em:nth-of-type(3) { color: #f9a825; }\ntd:nth-child(3) small { color: #4caf50; }\ntd:nth-child(5) small { color: #f44336; }\nsummary { list-style: none; cursor: pointer; }\nsummary::-webkit-details-marker { display: none; }\nsummary td:first-child::before { content: '▸ '; }\ndetails[open] > summary td:first-child::before { content: '▾ '; }\ndetails[open] > table td:first-child { padding-left: 10px !important; }\ndetails[open] > summary td:not(:first-child) { font-size: 0; }\ndetails[open] > summary td:not(:first-child) * { display: none; }\ndetails[open] > table tr:last-child td { border-top: 2px solid var(--divider-color) !important; }\ndetails[open] > table tr:last-child td:first-child { padding-left: 6px !important; }\nha-icon[icon=\"mdi:solar-power-variant\"] { color: #ffc107; }\nha-icon[icon=\"mdi:transmission-tower-export\"] { color: #4caf50; }\nha-icon[icon=\"mdi:transmission-tower-import\"] { color: #44739e; }\nha-icon[icon=\"mdi:water-boiler\"] { color: #ffc107; }\nha-icon[icon=\"mdi:home-lightning-bolt\"] { color: #ff9800; }\nha-icon[icon=\"mdi:washing-machine\"] { color: #42a5f5; }\nth, th:first-child { font-weight: bold; text-align: left !important; vertical-align: middle; }\nth, td { padding: 3px 6px !important; }\nha-icon { --mdc-icon-size: 16px; vertical-align: text-bottom; }\ntable { font-size: 12px; }\np { margin: 2px 0 !important; font-size: 12px; }\ntable + p { margin-top: 6px !important; }\np + p { margin-top: 8px !important; }\np small { font-size: inherit; color: #4caf50; }\np span { display: inline-block; min-width: 4.6em; }\np b span { min-width: 2.3em; text-align: right; }\np em { font-style: normal; display: inline-block; min-width: 4.4em; }\n"
                    }
                  }
                },
                {
                  "type": "entities",
                  "show_header_toggle": false,
                  "entities": [
                    {
                      "entity": "input_select.bedroom_ac",
                      "name": "Bedroom AC",
                      "icon": "mdi:air-conditioner",
                      "card_mod": {
                        "style": {
                          "ha-select $ ha-picker-field $": "ha-combo-box-item {\n  min-height: 44px !important;\n  height: 44px !important;\n}\n",
                          "ha-select $ ha-picker-field $ ha-combo-box-item $": "md-item {\n  min-height: 44px !important;\n  height: 44px !important;\n}\n",
                          ".": "{% set s = states(config.entity) %}\n{% set c = states(config.entity | replace('input_select.', 'climate.')) %}\n{% set ce = config.entity | replace('input_select.', 'climate.') %}\n{% set cur = state_attr(ce, 'current_temperature') %}\n{% set tgt = state_attr(ce, 'temperature') %}\n{% set live = c not in ['off', 'unavailable', 'unknown'] %}\n{% set dot = 'var(--red-color)' if c == 'heat' else 'var(--blue-color)' if c == 'cool' else 'var(--green-color)' %}\n:host {\n  --card-mod-icon-color: {{ 'var(--red-color)' if s == 'heating' else 'var(--blue-color)' if s == 'cooling' else 'var(--grey-color)' }};\n  {% if s == 'heating' %}--card-mod-icon: mdi:fire;{% elif s == 'cooling' %}--card-mod-icon: mdi:snowflake;{% endif %}\n}\n/* Current -> target temperature, moved to the row end via flex order */\nhui-generic-entity-row::before {\n  cursor: pointer;\n  content: \"{% if cur is number %}{{ '%g' | format(cur) }}°{% endif %}{% if tgt is number %}→{{ '%g' | format(tgt) }}°{% endif %}\";\n  order: 1;\n  margin-left: 8px;\n  white-space: nowrap;\n  font-size: 13px;\n  color: {{ dot if live else 'var(--secondary-text-color)' }};\n}\n/* Real AC state (climate entity): glowing dot at the row end while it runs */\nhui-generic-entity-row::after {\n  content: \"\";\n  order: 2;\n  flex: 0 0 10px;\n  width: 10px;\n  height: 10px;\n  margin-left: 6px;\n  border-radius: 50%;\n  {% if live %}\n  background: {{ dot }};\n  box-shadow: 0 0 6px 2px {{ dot }};\n  animation: ac-live 2s ease-in-out infinite;\n  {% else %}\n  background: transparent;\n  border: 1.5px solid var(--disabled-color, #bdbdbd);\n  box-sizing: border-box;\n  {% endif %}\n}\n@keyframes ac-live { 50% { opacity: 0.45; } }\n"
                        }
                      }
                    },
                    {
                      "entity": "input_select.big_bedroom_ac",
                      "name": "Big Bedroom AC",
                      "icon": "mdi:hvac",
                      "card_mod": {
                        "style": {
                          "ha-select $ ha-picker-field $": "ha-combo-box-item {\n  min-height: 44px !important;\n  height: 44px !important;\n}\n",
                          "ha-select $ ha-picker-field $ ha-combo-box-item $": "md-item {\n  min-height: 44px !important;\n  height: 44px !important;\n}\n",
                          ".": "{% set s = states(config.entity) %}\n{% set c = states(config.entity | replace('input_select.', 'climate.')) %}\n{% set ce = config.entity | replace('input_select.', 'climate.') %}\n{% set cur = state_attr(ce, 'current_temperature') %}\n{% set tgt = state_attr(ce, 'temperature') %}\n{% set live = c not in ['off', 'unavailable', 'unknown'] %}\n{% set dot = 'var(--red-color)' if c == 'heat' else 'var(--blue-color)' if c == 'cool' else 'var(--green-color)' %}\n:host {\n  --card-mod-icon-color: {{ 'var(--red-color)' if s == 'heating' else 'var(--blue-color)' if s == 'cooling' else 'var(--grey-color)' }};\n  {% if s == 'heating' %}--card-mod-icon: mdi:fire;{% elif s == 'cooling' %}--card-mod-icon: mdi:snowflake;{% endif %}\n}\n/* Current -> target temperature, moved to the row end via flex order */\nhui-generic-entity-row::before {\n  cursor: pointer;\n  content: \"{% if cur is number %}{{ '%g' | format(cur) }}°{% endif %}{% if tgt is number %}→{{ '%g' | format(tgt) }}°{% endif %}\";\n  order: 1;\n  margin-left: 8px;\n  white-space: nowrap;\n  font-size: 13px;\n  color: {{ dot if live else 'var(--secondary-text-color)' }};\n}\n/* Real AC state (climate entity): glowing dot at the row end while it runs */\nhui-generic-entity-row::after {\n  content: \"\";\n  order: 2;\n  flex: 0 0 10px;\n  width: 10px;\n  height: 10px;\n  margin-left: 6px;\n  border-radius: 50%;\n  {% if live %}\n  background: {{ dot }};\n  box-shadow: 0 0 6px 2px {{ dot }};\n  animation: ac-live 2s ease-in-out infinite;\n  {% else %}\n  background: transparent;\n  border: 1.5px solid var(--disabled-color, #bdbdbd);\n  box-sizing: border-box;\n  {% endif %}\n}\n@keyframes ac-live { 50% { opacity: 0.45; } }\n"
                        }
                      }
                    }
                  ],
                  "card_mod": {
                    "style": "ha-card {\n  --entities-card-row-gap: 0px;\n}\n"
                  }
                }
              ]
            },
            {
              "type": "custom:mod-card",
              "card": {
                "type": "vertical-stack",
                "cards": [
                  {
                    "type": "heading",
                    "heading": "Bizon",
                    "heading_style": "title",
                    "icon": "mdi:desktop-tower-monitor",
                    "badges": [
                      {
                        "type": "entity",
                        "entity": "input_boolean.bizon_autosuspend",
                        "icon": "mdi:checkbox-marked",
                        "show_icon": true,
                        "tap_action": {
                          "action": "toggle"
                        },
