                        "ha-markdown $": "h4 { margin: 0 0 6px; } p { margin: 0 0 2px; } ha-icon { --mdc-icon-size: 18px; color: var(--secondary-text-color); } summary { cursor: pointer; } details > div { margin: 2px 0 0 16px; }"
                      }
                    }
                  }
