                            "curve": "stepline",
                            "color": "#9c27b0",
                            "stroke_width": 3,
                            "opacity": 1,
                            "unit": " грн",
                            "show": {
                              "in_header": false,
                              "extremas": true
                            },
                            "group_by": {
                              "func": "raw"
                            },
                            "data_generator": "const prices_today = entity.attributes.prices_today || [];\nconst prices_tomorrow = entity.attributes.prices_tomorrow || [];\nconst data = [...prices_today, ...prices_tomorrow];\nif (data.length === 0) return [];\nreturn data.map((item) => {\n  return [new Date(item.time).getTime(), parseFloat(item.price)];\n});\n",
                            "float_precision": 2
                          }
                        ]
                      },
                      {
                        "type": "vertical-stack",
